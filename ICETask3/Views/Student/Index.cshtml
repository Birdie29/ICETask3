@model IEnumerable<ICETask3.Models.Student>
@{
	ViewData["Title"] = "Student List";
}

<h1>Student List</h1>
<p>
    <a asp-action="Export" asp-controller="Student" class="btn btn-success">Export to CSV</a>
</p>
<table class="table table-boarded table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>studentNumber</th>
            <th>studentName</th>
            <th>studentMark</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentNumber</td>
                <td>@student.Name</td>
                <td>@student.Mark</td>
            </tr>
        }
    </tbody>

    <h2>Add student</h2>
    <form method="post" asp-action="AddStudent" asp-controller="Student">
        <div class="form-group">
            <label for="studentNumber">Student Number:</label>
            <input type="text" class="form-control" id="studentNumber" name="studentNumber" required />
        </div>
        <div class="form-group">
            <label for="studentName">Student Name:</label>
            <input type="text" class="form-control" id="studentName" name="studentName" required />
        </div>
        <div class="form-group">
            <label for="studentMark">Student Mark:</label>
            <input type="number" class="form-control" id="studentMark" name="studentMark" required />
        </div>
        <button type="submit" class="btn btn-primary">Add Student</button>
</table>